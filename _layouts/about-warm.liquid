---
layout: default
---
<div class="academic-home">
  {% assign sections = content | split: '<!-- background -->' %}
  <section class="home-hero" aria-labelledby="home-name">
    <div class="home-introduction">
      <p class="home-eyebrow">Zhejiang University <span aria-hidden="true">/</span> VIPA Lab</p>
      <h1 id="home-name">
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <p class="home-role">PhD Student · Computer Science</p>
      <div class="home-bio">{{ sections.first }}</div>
      <nav class="home-contact" aria-label="Contact and profiles">
        {% if site.data.socials.email -%}
          <a href="mailto:{{ site.data.socials.email }}">Email <span aria-hidden="true">↗</span></a>
        {%- endif %}
        {% if site.data.socials.scholar_userid -%}
          <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
            >Google Scholar <span aria-hidden="true">↗</span></a
          >
        {%- endif %}
        {% if site.data.socials.github_username -%}
          <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub <span aria-hidden="true">↗</span></a>
        {%- endif %}
        <a href="{{ '/cv/' | relative_url }}">CV <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
    {% if page.profile.image %}
      <figure class="home-portrait">
        {% assign portrait = page.profile.image | prepend: '/assets/img/' %}
        <img src="{{ portrait | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}" width="240" height="290" fetchpriority="high">
        <figcaption>Hangzhou, China</figcaption>
      </figure>
    {% endif %}
  </section>

  {% if page.announcements.enabled %}
    <section class="home-news" aria-labelledby="home-news-title">
      <h2 id="home-news-title">Latest news</h2>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-research" id="research" aria-labelledby="research-title">
      <div class="home-section-heading">
        <div>
          <p class="home-eyebrow">Ideas &amp; publications</p>
          <h2 id="research-title">Selected research</h2>
        </div>
        <a href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
      </div>
      {% bibliography --template home-bib --group_by none --query @*[selected=true] %}
    </section>
  {% endif %}

  <section class="home-background" id="background" aria-label="Background">
    {{ sections[1] }}
  </section>
</div>
